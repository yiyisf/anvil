# ── 模型（与 spike 里跑通的配置保持一致）──────────────
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_API_KEY=sk-noauth
PI_MODEL=anthropic/你的内部模型名
PI_PROVIDER=anthropic        # anthropic(/v1/messages) | openai(/v1/responses)

# ── 代码仓库与工作副本 ────────────────────────────────
REPO_PATH=/path/to/your/repo          # 已有 git 仓库
WORKTREES_DIR=/path/to/worktrees      # 存放各需求 worktree 的父目录（会自动创建）
BASE_BRANCH=                            # 留空自动探测；填错会自动回退到当前 HEAD

# ── sandbox 内可用的真实工具（桥接到宿主进程）──────────
# just-bash 自身没有真实二进制，不配这项则 skill 无法运行测试。
# 只放确实需要的，等于把宿主命令执行权交给代理。
# 也可在项目仓库根放 agent.config.json 覆盖（优先级更高，便于按项目定制）：
#   {
#     "sandboxTools": ["node","pnpm","git","mvn"],   ← bash 能调的真实二进制
#     "toolTimeoutMs": 300000,
#     "agentTools": {                                 ← LLM 能调的工具（另一层）
#       "analysis": { "allow": ["read","grep","glob"] },
#       "impl":     { "allow": ["read","write","edit","bash"] }
#     }
#   }
SANDBOX_TOOLS=node,npm,npx,git
TOOL_TIMEOUT_MS=180000

# ── 其他 ─────────────────────────────────────────────
DATA_DIR=.data
PORT=8787
